# Copy to backend/.env (never commit the real file; it is git-ignored). Loaded at startup whatever directory
# the server starts from; variables already set in your shell win over the file.

# Hindsight Cloud (the team key is owned by P4; get it privately, never paste it in chat or Git).
# With no key the memory module reports "not configured" instead of pretending to retain anything.
HINDSIGHT_API_KEY=
# Optional; the adapter defaults to Hindsight Cloud.
HINDSIGHT_BASE_URL=
# Set to 1 only for offline work: memory is kept in a local file and always reported as "fixture", never "live".
HINDSIGHT_SIMULATE=

# Lets POST /api/demo/reset clear a demo scenario. Leave false unless you mean to reset demo memory.
DEMO_RESET_ENABLED=false
# Relative paths resolve against the repository root.
DATABASE_PATH=.local/incento.sqlite3
CORS_ORIGINS=http://localhost:5173
